{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "type": "object",
  "name": "HowTo",
  "description": "Instructions that explain how to achieve a result by performing a sequence of steps.",
  "properties": {
    "type": { "type": "string" },
    "context": { "type": "string" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "url": { "type": "string" },
    "image": { "type": "string" },
    "totalTime": { "type": "string" },
    "prepTime": { "type": "string" },
    "performTime": { "type": "string" },
    "estimatedCost": { "type": { "$ref": "#/definitions/MonetaryAmount" } },
    "supply": { "type": "array", "items": { "type": { "$ref": "#/definitions/HowToSupply" } } },
    "tool": { "type": "array", "items": { "type": { "$ref": "#/definitions/HowToTool" } } },
    "step": { "type": "array", "items": { "type": { "$ref": "#/definitions/HowToStep" } } },
    "yield": { "type": "string" },
    "author": { "type": { "$ref": "schema-org-person.json" } },
    "datePublished": { "type": "date" },
    "video": { "type": { "$ref": "schema-org-video-object.json" } },
    "sameAs": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["name", "step"],
  "definitions": {
    "HowToStep": {
      "type": "object",
      "name": "HowToStep",
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "text": { "type": "string" },
        "url": { "type": "string" },
        "image": { "type": "string" },
        "position": { "type": "int32" }
      }
    },
    "HowToSupply": {
      "type": "object",
      "name": "HowToSupply",
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "requiredQuantity": { "type": "number" },
        "image": { "type": "string" }
      }
    },
    "HowToTool": {
      "type": "object",
      "name": "HowToTool",
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "image": { "type": "string" }
      }
    },
    "MonetaryAmount": {
      "type": "object",
      "name": "MonetaryAmount",
      "properties": {
        "type": { "type": "string" },
        "currency": { "type": "string" },
        "value": { "type": "number" }
      }
    }
  }
}
